CameraControlValue[] values  # applied in order
---
uint8 OK=0
uint8 DEVICE_UNAVAILABLE=1
uint8 UNKNOWN_CONTROL=2
uint8 READ_ONLY=3
uint8 INVALID_MENU_ENTRY=4
uint8 OUT_OF_RANGE=5
uint8 BAD_STEP=6
uint8 INACTIVE=7
uint8 DRIVER_REJECTED=8
uint8 EMPTY_REQUEST=9

uint8 status
string message            # human-readable reason
uint32 failed_index       # entry that failed
uint32 applied_count      # entries written
CameraControl[] controls  # read back after write
